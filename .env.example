# textree 配置（TEXTREE_ 前缀）
TEXTREE_HOST=127.0.0.1
TEXTREE_PORT=5000
TEXTREE_DATABASE_URL=sqlite:///data/tree.db

# 模型（OpenAI 兼容；首次运行向导会引导填写）
TEXTREE_API_KEY=
TEXTREE_API_URL=https://api.deepseek.com/chat/completions
TEXTREE_MODEL=deepseek-chat
TEXTREE_PROVIDER_TIMEOUT_SECONDS=45

# 配额（BYO-Key 默认不限额；托管代缴费模式再启用）
TEXTREE_QUOTA_ENABLED=false
TEXTREE_MAX_QUESTIONS=8
