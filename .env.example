# treening 配置（TREENING_ 前缀）
TREENING_HOST=127.0.0.1
TREENING_PORT=5000
TREENING_DATABASE_URL=sqlite:///data/tree.db

# 模型（OpenAI 兼容；首次运行向导会引导填写）
TREENING_API_KEY=
TREENING_API_URL=https://api.deepseek.com/chat/completions
TREENING_MODEL=deepseek-chat
TREENING_PROVIDER_TIMEOUT_SECONDS=45

# 个性化人设（注入到 system.md 之后；可留空）
# 示例：TREENING_PERSONA=你是一名有二十年嵌入式开发经验的老工程师，说话直接，先结论后理由
TREENING_PERSONA=

# 配额（默认启用：普通用户每人每日默认 20 次，管理员不限，可在管理面板按人覆盖）
TREENING_QUOTA_ENABLED=true
TREENING_MAX_QUESTIONS=20

# 分支节点命名单字长度上限（配置页自定义命名；默认 6 字）
TREENING_BRANCH_LABEL_MAX_CHARS=6

# ── 生产加固 ──
# 注册策略：open（自由注册）/ invite（邀请码）/ closed（关闭）。
# 注意：管理面板可运行时改，此环境变量只是无 settings.json 时的兜底
TREENING_REGISTRATION_MODE=open
# 错误聚合：填 Sentry DSN 后自动启用（需在镜像中安装 sentry-sdk 可选依赖）
TREENING_SENTRY_DSN=
# 生产（nginx 反代）下必须为 true：启用真实 IP 信任链 + Secure Cookie
# Dockerfile 已默认置 true，本地裸跑开发请保持 false
TREENING_BEHIND_PROXY=true
TREENING_COOKIE_SECURE=true
# 额外放行的 Origin（逗号分隔；缺省仅允许同源）。仅当有独立前端域名时才需要填
TREENING_ALLOWED_ORIGINS=

# ── 敏感配置安全 ──
# 强烈建议：API Key / SMTP 授权码放在单独 .env 文件并 chmod 600，
# 不要提交到仓库，也不要写进 settings.json 明文之外再传播。
# 服务器被攻破即视为 Key 泄露——威胁边界请按此理解，不要依赖"加密 at rest"。
